# Application
NODE_ENV=development
PORT=3000

# Database (local MongoDB; with Docker Compose this is overridden automatically)
MONGO_URI=mongodb://localhost:27017/ecommerce_inventory

# Authentication
JWT_SECRET=replace_this_with_a_long_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Admin seed (used by `npm run seed:admin`)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234

# Docker Compose only (MongoDB root credentials)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=example
